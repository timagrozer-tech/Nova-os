#!/usr/bin/env python3
"""Start a Windows executable with Wine after the user explicitly confirms."""
import os
import shutil
import subprocess
import sys
from pathlib import Path
from PyQt6.QtWidgets import QApplication, QFileDialog, QMessageBox


def main():
    app = QApplication(sys.argv)
    supplied = sys.argv[1] if len(sys.argv) > 1 else ''
    if supplied and Path(supplied).is_file():
        path = Path(supplied).resolve()
    else:
        name, _ = QFileDialog.getOpenFileName(None, 'Windows-программа или установщик',
                                              str(Path.home()), 'Windows (*.exe *.msi);;Все файлы (*)')
        if not name:
            return 0
        path = Path(name).resolve()
    if path.suffix.lower() not in ('.exe', '.msi'):
        QMessageBox.warning(None, 'NOVA', 'Выберите файл .exe или .msi.')
        return 2
    if not shutil.which('wine'):
        QMessageBox.warning(None, 'NOVA', 'Wine не установлен.')
        return 3
    response = QMessageBox.question(
        None, 'Запуск Windows-программы',
        'Windows-приложения запускаются с вашими правами и могут читать ваши файлы.\n'
        'Открывайте только программы из доверенных источников.\n\n'
        f'Запустить {path.name}?',
        QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
        QMessageBox.StandardButton.No)
    if response != QMessageBox.StandardButton.Yes:
        return 0
    prefix = Path.home() / '.local/share/nova/wine-prefixes/default'
    prefix.parent.mkdir(parents=True, exist_ok=True)
    env = os.environ.copy()
    env['WINEPREFIX'] = str(prefix)
    command = ['wine', 'msiexec', '/i', str(path)] if path.suffix.lower() == '.msi' else ['wine', str(path)]
    try:
        subprocess.Popen(command, env=env, cwd=str(path.parent), start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as exc:
        QMessageBox.critical(None, 'NOVA', str(exc))
        return 1
    QMessageBox.information(None, 'NOVA',
                            'Программа запущена через Wine. Работа конкретного EXE не гарантируется.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
