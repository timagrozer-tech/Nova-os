        self.button(v, 'Открыть диагностику', lambda: self.open('nova-health'))
        self.button(v, 'Мастер первого запуска', lambda: self.open('nova-first-run'))
        self.button(v, 'Проверка перед установкой', lambda: self.open('nova-preflight'))
        return page

    def page_privacy(self):
        page, lay = self.page('Контроль доступа приложений, локальных данных, истории, Bluetooth, сети и индексации.')
        v = self.card(lay, 'Разрешения и изоляция Flatpak',
                      'Flatseal позволяет ограничить доступ приложений к файловой системе, устройствам и сеансу.')
        self.button(v, 'Открыть Flatseal', lambda: self.open('flatpak', ['run', 'com.github.tchx84.Flatseal']))
        install_view = self.log(v)
        self.button(v, 'Установить Flatseal из Flathub',
                    lambda: self.run_process(['/usr/local/lib/nova/nova-flatpak-flatseal'], install_view)
                    if ui.confirm(self, 'Загрузка компонентов', 'Установить Flatseal с Flathub через интернет?') else None)
        self.button(v, 'Информация о разрешениях Flatpak', lambda: self.url('https://docs.flathub.org/docs/for-users/permissions'))
        v = self.card(lay, 'Индексирование и поиск', 'Баланс между мгновенным поиском файлов и локальной приватностью.')
        view = self.log(v)
        self.button(v, 'Состояние индексирования', lambda: self.run_process(['balooctl6','status'], view))
        for label, action in [('Включить локальный индекс', 'enable'), ('Выключить индекс файлов', 'disable')]:
            def operation(act=action):
                if ui.confirm(self, 'Индексирование', f'Baloo: {act}? Изменится скорость поиска файлов.'):
                    self.run_process(['balooctl6', act], view)
            self.button(v, label, operation)
        self.button(v, 'Настройки поиска KDE', lambda: self.kcm('kcm_baloofile'))
        v = self.card(lay, 'Сетевые настройки', 'DNS, прокси, VPN, Wi-Fi, Bluetooth и проверка разрешённых служб.')
        self.button(v, 'Настройки сети', lambda: self.open('systemsettings'))
        self.button(v, 'Настройки Bluetooth', lambda: self.open('systemsettings'))
        return page

    def page_defender(self):
        page, lay = self.page('NOVA Defender объединяет реальные средства защиты Linux. Не является аналогом Microsoft Defender EDR.')
        v = self.card(lay, 'Центр защиты', 'AppArmor, UFW, ClamAV, состояние сигнатур и проверка файлов.')
        self.button(v, 'Открыть NOVA Defender', lambda: self.open('nova-defender'))
        v = self.card(lay, 'Сетевой экран', 'Запрещает новые входящие подключения; сетевые сервисы могут потребовать исключений.')
        output = self.log(v)
        self.button(v, 'Проверить состояние UFW', lambda: self.run_process(['pkexec','/usr/local/lib/nova/nova-admin','firewall-status'], output))
        self.button(v, 'Включить UFW', lambda: self.admin('firewall-on', output, 'Включить блокировку входящих подключений?'))
        self.button(v, 'Выключить UFW', lambda: self.admin('firewall-off', output, 'Отключить сетевой экран? Это снижает защиту.'))
        v = self.card(lay, 'Безопасность приложений', 'Linux AppArmor, безопасные контейнеры Flatpak, штатные обновления.')
        self.button(v, 'Проверить AppArmor', lambda: self.run_process(['aa-status'], output))
        self.button(v, 'Настройки разрешений', lambda: self.select_page('Конфиденциальность'))
        return page

    def page_performance(self):
        page, lay = self.page('Мониторинг температуры, CPU, RAM и батареи, игровые настройки и безопасное управление нагрузкой.')
        v = self.card(lay, 'NOVA Performance Center', 'Профили питания, предупреждения по температурам, пользовательские процессы и игровой запуск. Без разгона или изменения вентиляторов.')
        self.button(v, 'Открыть Performance Center', lambda: self.open('nova-performance'))
        self.button(v, 'Подробный мониторинг KDE', lambda: self.open('plasma-systemmonitor'))
        return page

    def page_optimizer(self):
        page, lay = self.page('Консервативная оптимизация: никаких отключений важных защит, случайных чистильщиков RAM и опасных твиков.')
        v = self.card(lay, 'Производительность и автономность', 'Режимы зависят от поддерживаемого платформой драйвера.')
        self.button(v, 'Открыть NOVA Performance Center', lambda: self.open('nova-performance'))
        output = self.log(v)
        self.button(v, 'Доступные профили', lambda: self.run_process(['powerprofilesctl','list'],output))
        for caption, profile in [('Энергосбережение', 'power-saver'), ('Сбалансированный', 'balanced'), ('Максимальная производительность', 'performance')]:
            self.button(v, caption, lambda p=profile: self.run_process(['powerprofilesctl','set',p], output))
        v = self.card(lay, 'Бережная очистка', 'Очистка кэша APT не затрагивает документы и программы. Остальные данные не стираются автоматически.')
        self.button(v, 'Очистить кэш APT', lambda: self.admin('clean-cache', output, 'Удалить скачанные архивы пакетов APT?'))
        self.button(v, 'Проверить использование журнала', lambda: self.run_process(['journalctl','--disk-usage'],output))
        v = self.card(lay, 'Диагностика', 'Проверка запуска и дисков; обслуживание SSD выполняет штатный таймер TRIM.')
        self.button(v, 'Время загрузки Linux', lambda: self.run_process(['systemd-analyze'],output))
        self.button(v, 'Состояние TRIM', lambda: self.run_process(['systemctl','status','fstrim.timer','--no-pager'],output))
        self.button(v, 'Здоровье дисков', lambda: self.open('systemsettings'))
        self.button(v, 'Автозагрузка и фоновые службы', lambda: self.open('systemsettings'))
        return page

