        status = self.log(v)
        self.button(v, 'Состояние Waydroid', lambda: self.run_process(['waydroid','status'], status))
        v = self.card(lay, 'Почта и сервисы Google', 'Gmail безопаснее открывать в браузере; аккаунт NOVA OS не хранит и не перехватывает.')
        self.button(v, 'Gmail в браузере', lambda: self.url('https://mail.google.com/'))
        self.button(v, 'Google Диск в браузере', lambda: self.url('https://drive.google.com/'))
        self.button(v, 'Документация о сертификации Google Play', lambda: self.url('https://docs.waydro.id/faq/google-play-certification'))
        return page

    def page_sound_studio(self):
