#!/usr/bin/env python3
"""NOVA Control 0.12 — adaptive navigation, audited actions, no silent dangerous tweaks."""
import shutil
import subprocess
import sys
import nova_ui as ui
from PyQt6.QtCore import Qt, QUrl
from PyQt6.QtGui import QDesktopServices, QKeySequence, QShortcut
from PyQt6.QtWidgets import (QApplication, QHBoxLayout, QLabel, QLineEdit, QMainWindow,
                             QTextEdit, QVBoxLayout, QWidget)

def cmd(argv, timeout=8):
    try:
        output = subprocess.run(argv, text=True, capture_output=True, timeout=timeout)
        return (output.stdout + '\n' + output.stderr).strip() or f'Код завершения: {output.returncode}'
    except (OSError, subprocess.TimeoutExpired) as err:
        return f'Недоступно: {err}'


def memory_line():
    """Second line of `free -h` or a readable fallback (never raises)."""
    lines = cmd(['free', '-h']).splitlines()
    return lines[1] if len(lines) > 1 else ('Память: ' + (lines[0] if lines else 'нет данных'))


VERSION = ui.nova_version()


class Control(QMainWindow):
    def __init__(self):
        super().__init__()
        ui.setup_window(self, 'NOVA Control · Air', size=(1180, 760), app_id='nova-control')
        self.jobs = []
        root = QWidget(); outer = QVBoxLayout(root)
        outer.setContentsMargins(18, 14, 18, 10)
        top = QHBoxLayout(); outer.addLayout(top)
        top.addWidget(ui.header('NOVA Control',
            'Приватность, безопасность, программы, оборудование и персонализация — в одном месте.'), 1)
        self.search = QLineEdit(); self.search.setPlaceholderText('Поиск раздела…  (Ctrl+F)')
        self.search.setClearButtonEnabled(True); self.search.setMaximumWidth(360)
        self.search.setAccessibleName('Поиск раздела')
        top.addWidget(self.search, 0, Qt.AlignmentFlag.AlignTop)
        self.nav = ui.adaptive_nav()
        outer.addWidget(self.nav, 1)
        self.pages = [
            ('⌂ Обзор', self.page_home),
            ('◐ Оформление и панель', self.page_personalize),
            ('♡ NOVA Health', self.page_health),
            ('▣ Драйверы и оборудование', self.page_drivers),
            ('◉ NOVA Performance', self.page_performance),
            ('◈ Конфиденциальность', self.page_privacy),
            ('⬡ NOVA Defender', self.page_defender),
            ('⚡ NOVA Optimizer', self.page_optimizer),
            ('▣ NOVA Uninstaller', self.page_uninstaller),
            ('▤ Диспетчер задач', self.page_tasks),
            ('⌕ Быстрый поиск', self.page_search),
            ('▧ Windows-программы', self.page_windows),
            ('⇄ Windows и перенос данных', self.page_migration),
            ('◉ Android и Google', self.page_android),
            ('♫ Звуки NOVA', self.page_sound_studio),
            ('🎮 Игры и геймпады', self.page_gaming),
            ('▣ Телефон и Samsung', self.page_phone),
            ('◉ Персонализация KDE', self.page_appearance),
            ('▱ Дисплей и звук', self.page_display),
            ('⌨ Клавиатура и горячие клавиши', self.page_keyboard),
            ('⋈ Сеть и устройства', self.page_network),
            ('⇪ Обновления и копии', self.page_update),
        ]
        for title, renderer in self.pages:
            self.nav.add_page(title, renderer())
        self.search.textChanged.connect(self.nav.set_filter)
        self.nav.select(0)
        footer = QLabel(f'NOVA OS {VERSION} — экспериментальная сборка. Защита и совместимость зависят от оборудования, настроек и конкретных программ.')
        footer.setObjectName('description'); footer.setWordWrap(True); outer.addWidget(footer)
        self.setCentralWidget(root)
        QShortcut(QKeySequence('Ctrl+F'), self, activated=lambda: (self.search.setFocus(), self.search.selectAll()))
        QShortcut(QKeySequence('Escape'), self.search, activated=self.search.clear)

    # Compatibility helpers used by all page builders (unchanged signatures).
    def page(self, intro):
        return ui.scroll_page(intro)

    def card(self, parent, title, description):
        frame, layout = ui.card(title, description)
        ui.add_to_page(parent, frame)
        return layout

    def button(self, box, label, callback, variant='secondary'):
        b = ui.make_button(label, callback, variant)
        box.addWidget(b); return b

    def log(self, box, minheight=105):
        w = QTextEdit(); w.setReadOnly(True); w.setMinimumHeight(minheight)
        box.addWidget(w); return w

    def open(self, executable, argv=None):
        if shutil.which(executable):
            try: subprocess.Popen([executable] + (argv or []), start_new_session=True)
            except OSError as exc: ui.error(self, 'NOVA', str(exc))
        else: ui.error(self, 'NOVA', f'Компонент не найден: {executable}')

    def kcm(self, module):
        self.open('kcmshell6', [module]) if shutil.which('kcmshell6') else self.open('systemsettings')

    def url(self, url): QDesktopServices.openUrl(QUrl(url))

    def run_process(self, command, view):
        runner = ui.process_runner(self, view)
        proc = runner(list(command))
        if proc is not None:
            self.jobs.append(proc)
            proc.finished.connect(lambda *_a, p=proc: self.jobs.remove(p) if p in self.jobs else None)

    def admin(self, task, view, question):
        if ui.confirm(self, 'Подтверждение', question):
            self.run_process(['pkexec', '/usr/local/lib/nova/nova-admin', task], view)

    def select_page(self, name):
        for i, (title, _) in enumerate(self.pages):
            if name in title:
                self.search.setText(''); self.nav.select(i); break

    def page_personalize(self):
        page, lay = self.page('Режимы рабочего стола Windows-like / Dock-like / Hybrid, светлая и тёмная тема NOVA Air, '
                              'акцентный цвет, плотность и анимации. Перед изменением панели создаётся резервная копия.')
        v = self.card(lay, 'NOVA Персонализация', 'Мастер оформления: тема, акцент, режим панели, плотность, анимации, сброс к KDE.')
        self.button(v, 'Открыть персонализацию', lambda: self.open('nova-personalize'), 'primary')
        v = self.card(lay, 'NEON//SYS — киберпанк', 'Встроенное неоновое оформление: HUD-панель, док, живые QML-обои, '
                      'виджеты, звуки и режимы WORK/GAME/NIGHT/FOCUS. Без сторонних программ, прежний вид возвращается.')
        self.button(v, 'Центр NEON//SYS (Win+Alt+N)', lambda: self.open('nova-neon-center'))
        out = None
        v = self.card(lay, 'Быстрое переключение режима', 'Текущая раскладка сохраняется в ~/.local/share/nova/layout-backups.')
        out = self.log(v, 80)
        for caption, mode in [('Windows-like: панель снизу по центру', 'windows'),
                              ('Dock-like: верхняя строка + док', 'dock'),
                              ('Hybrid: плавающая панель', 'hybrid')]:
            self.button(v, caption, lambda _c=False, m=mode, o=out: ui.confirm(self, 'Изменить панель?',
                        'Текущие панели Plasma будут заменены (с резервной копией).') and self.run_process(['nova-layout', 'apply', m], o))
        self.button(v, 'Вернуть KDE Plasma по умолчанию', lambda: ui.confirm(self, 'Сброс оформления',
                    'Вернуть стандартные оформление и панель KDE (Breeze)? Текущая раскладка сохранится.', danger=True,
                    yes='Вернуть KDE') and self.run_process(['nova-layout', 'reset-kde'], out), 'danger')
        v = self.card(lay, 'Самопроверка системы', 'Сеанс, графика, экраны, сеть, звук, защита — отчёт без изменений системы.')
        out2 = self.log(v, 120)
        self.button(v, 'Запустить nova-selftest', lambda: self.run_process(['nova-selftest'], out2))
        return page

    def page_home(self):
        page, lay = self.page('Состояние NOVA OS и основные модули. Сведения остаются локально на ноутбуке.')
        v = self.card(lay, 'Система', 'Драйверы, память, сеть, процессор и версия ядра.')
        view = self.log(v)
        def update():
            view.setPlainText(f'NOVA OS {VERSION}  ·  ' + cmd(['uname','-sr']) + '\n' +
                 memory_line() + '\n' +
                 cmd(['nmcli','-t','-f','STATE','general']) + '\n' +
                 '\nВидеокарты:\n' + '\n'.join(l for l in cmd(['lspci']).splitlines() if 'VGA' in l or '3D controller' in l))
        self.button(v, 'Обновить состояние', update); update()
        v = self.card(lay, 'Панель быстрых действий', 'Один клик для основных инструментов без терминала.')
        for text, command in [
            ('NOVA Персонализация', 'nova-personalize'),
            ('NEON//SYS — киберпанк-оформление', 'nova-neon-center'),
            ('NOVA — дисплеи и частота', 'nova-display'),
            ('NOVA — горячие клавиши', 'nova-hotkeys'),
            ('NOVA Game Bar', 'nova-game-bar'),
            ('NOVA Health', 'nova-health'),
            ('NOVA Performance Center', 'nova-performance'),
            ('NOVA Welcome', 'nova-first-run'),
            ('NOVA Defender', 'nova-defender'),
            ('NOVA Uninstaller', 'nova-uninstaller'), ('Диспетчер задач', 'nova-task-manager'),
            ('Системные настройки KDE', 'systemsettings'),
            ('Проверка оборудования перед установкой', 'nova-preflight'),
            ('Android Hub', 'nova-android-hub'),
            ('NOVA Sound Studio', 'nova-sound-studio'),
            ('NOVA Gaming', 'nova-gaming'),
            ('Проверка геймпада', 'nova-gamepad-test'),
            ('NOVA Phone Hub', 'nova-phone-hub'),
            ('Установить рядом с Windows 11', 'nova-dualboot'),
            ('Перенос данных Windows', 'nova-migration')]:
            self.button(v, text, lambda c=command: self.open(c))
        return page

