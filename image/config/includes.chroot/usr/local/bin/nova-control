    def page_appearance(self):
        page, lay = self.page('Полная кастомизация KDE Plasma: темы, иконки, оформление окон, виртуальные столы, плагины, панели, эффекты и горячие клавиши.')
        v = self.card(lay, 'NOVA Air — тема приложений', 'Светлый/тёмный стиль NOVA Control, Defender, Android Hub и других инструментов. Перезапустите приложения NOVA после изменения.')
        def save_theme(kind):
            try:
                ui.save_choice(kind)
                self.setStyleSheet(ui.stylesheet())
            except (OSError, ValueError) as exc:
                ui.error(self, 'NOVA', 'Не удалось сохранить тему: ' + str(exc))
        self.button(v, 'Светлая тема NOVA', lambda: save_theme('light'))
        self.button(v, 'Тёмная тема NOVA', lambda: save_theme('dark'))
        self.button(v, 'Как в KDE Plasma (авто)', lambda: save_theme('auto'))
        self.button(v, 'Настройки оформления Plasma', lambda: self.open('systemsettings'))
        v = self.card(lay, 'Глобальные темы и цвета', 'NOVA Air: светлая и тёмная темы интерфейса приложений NOVA; KDE Plasma оформляется отдельно.')
        for title, module in [('Глобальная тема', 'kcm_lookandfeel'), ('Цветовые схемы', 'kcm_colors'),
                ('Иконки', 'kcm_icons'), ('Курсоры', 'kcm_cursortheme'), ('Шрифты', 'kcm_fonts'),
                ('Рамки окон', 'kcm_kwindecoration'), ('Стиль приложений', 'kcm_style')]:
            self.button(v, title, lambda m=module: self.kcm(m))
        v = self.card(lay, 'Рабочее пространство', 'Эффекты, виртуальные столы, правила окон, жесты, углы экрана и многоэкранные конфигурации.')
        for title, module in [('Эффекты рабочего стола', 'kcm_kwin_effects'), ('Виртуальные столы', 'kcm_kwin_virtualdesktops'),
                 ('Горячие клавиши', 'kcm_keys'), ('Поведение окон', 'kcm_kwinoptions'),
                 ('Экран блокировки', 'screenlocker'), ('Автозапуск', 'kcm_autostart')]:
            self.button(v, title, lambda m=module: self.kcm(m))
        self.button(v, 'Все настройки KDE', lambda: self.open('systemsettings'))
        return page

    def page_display(self):
        page, lay = self.page('Настройка экрана, цветовой температуры, масштабирования, частоты обновления, звука и устройств.')
        v = self.card(lay, 'Дисплей', 'Разрешение, частота обновления (Гц), масштаб, второй монитор (как Win+P), профили мониторов, яркость внешнего монитора.')
        self.button(v, 'NOVA — дисплеи (частота, второй монитор)', lambda: self.open('nova-display'), 'primary')
        self.button(v, 'Экран и мониторы KDE', lambda: self.kcm('kcm_kscreen'))
        self.button(v, 'Энергосбережение', lambda: self.kcm('powerdevilglobalconfig'))
        v = self.card(lay, 'Аудио и микрофоны', 'Звуковые устройства и входы PipeWire/WirePlumber, уровень громкости и приложения.')
        self.button(v, 'Звук', lambda: self.kcm('kcm_pulseaudio'))
        self.button(v, 'Каталог звуков и события зарядки', lambda: self.open('nova-sound-studio'))
        self.button(v, 'Устройства и Bluetooth', lambda: self.kcm('bluedevilglobal'))
        return page

    def page_keyboard(self):
        page, lay = self.page('Сочетания клавиш как в Windows (Win+↑, Win+Tab, Win+Shift+S, Ctrl+Shift+Esc, Win+I, Win+G…), '
                              'мультимедийные клавиши и проверка, распознаёт ли система кнопку ноутбука.')
        v = self.card(lay, 'NOVA — горячие клавиши', 'Шпаргалка, проверка клавиш, применение и возврат стандартов KDE.')
        self.button(v, 'Открыть горячие клавиши', lambda: self.open('nova-hotkeys'), 'primary')
        out = self.log(v, 80)
        self.button(v, 'Применить сочетания как в Windows', lambda: self.run_process(['nova-hotkeys', 'apply'], out))
        self.button(v, 'Вернуть стандартные сочетания KDE', lambda: ui.confirm(self, 'Сброс сочетаний',
                    'Вернуть стандартные сочетания KDE?') and self.run_process(['nova-hotkeys', 'reset-kde'], out))
        v = self.card(lay, 'Раскладка и ввод', 'EN/RU по Alt+Shift и Win+Пробел; тачпад, мышь, экранная клавиатура.')
        for title, module in [('Раскладки клавиатуры', 'kcm_keyboard'), ('Тачпад', 'kcm_touchpad'),
                              ('Мышь', 'kcm_mouse'), ('Все комбинации клавиш KDE', 'kcm_keys')]:
            self.button(v, title, lambda m=module: self.kcm(m))
        return page

    def page_drivers(self):
        page, lay = self.page('Безопасная диагностика GPU, Wi-Fi, сети, батареи и Secure Boot. Инвентаризация не гарантирует работу всех устройств.')
        v = self.card(lay, 'NOVA Driver Center', 'Диагностика оборудования, скачивание официальных пакетов Debian, установка проверенных прошивок и переход к сайтам производителей — с подтверждением пользователя.')
        self.button(v, 'Открыть NOVA Driver Center', lambda: self.open('nova-driver-center'))
        self.button(v, 'Общая диагностика NOVA Health', lambda: self.open('nova-health'))
        self.button(v, 'Проверка перед установкой', lambda: self.open('nova-preflight'))
        v = self.card(lay, 'Проверка прошивок', 'Проверять обновления безопаснее через KDE Discover и fwupd. Список поддерживаемых устройств неполон.')
        self.button(v, 'Открыть обновления', lambda: self.open('plasma-discover'))
        return page

    def page_network(self):
        page, lay = self.page('NetworkManager, Bluetooth, прошивки устройств, USB и реальное состояние подключённых драйверов.')
        v = self.card(lay, 'Wi-Fi и соединения', 'Wi-Fi, Ethernet, VPN, прокси и другие подключения средствами NetworkManager.')
        self.button(v, 'Настройки соединений', lambda: self.open('nm-connection-editor') if shutil.which('nm-connection-editor') else self.open('systemsettings'))
        v = self.card(lay, 'Диагностика оборудования', 'Проверка драйверов и периферии; NVIDIA не устанавливается вслепую.')
        output = self.log(v)
        self.button(v, 'Полные сведения об устройстве', lambda: self.run_process(['inxi','-Fz'], output))
        self.button(v, 'Модули драйверов PCI', lambda: self.run_process(['lspci','-nnk'], output))
        self.button(v, 'NOVA Driver Center', lambda: self.open('nova-driver-center'))
        self.button(v, 'Проверка совместимости перед установкой', lambda: self.open('nova-preflight'))
        self.button(v, 'Доступные обновления firmware', lambda: self.run_process(['fwupdmgr','get-updates'], output))
        return page

    def page_update(self):
        page, lay = self.page('Система обновлений и восстановление: изменения не отключают исправления безопасности.')
        v = self.card(lay, 'Обновления ОС и прошивок', 'Обновления пакетов Debian, Flatpak и устройства с fwupd.')
        self.button(v, 'NOVA Update & Recovery Center', lambda: self.open('nova-update-center'))
        self.button(v, 'Открыть Discover', lambda: self.open('plasma-discover'))
        v = self.card(lay, 'Снимки и резервные копии', 'Timeshift: настройка расписания и точек восстановления. Для личных файлов требуется отдельная резервная копия.')
        self.button(v, 'Открыть Timeshift', lambda: self.open('timeshift-launcher') if shutil.which('timeshift-launcher') else self.open('nova-update-center'))
        return page

def main():
    app = QApplication(sys.argv)
    app.setApplicationName('NOVA Control')
    app.setDesktopFileName('nova-control')
    window = Control(); window.show(); return app.exec()

if __name__ == '__main__': raise SystemExit(main())
