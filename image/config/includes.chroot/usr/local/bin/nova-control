        self.button(v, 'Открыть NOVA Uninstaller', lambda: self.open('nova-uninstaller'))
        v = self.card(lay, 'Windows-приложения', 'Окружения Bottles удаляются в интерфейсе Bottles, чтобы не повредить остальные программы.')
