/* NOVA Sakura — generated by nova_ui.py (do not edit by hand) */
QWidget { background: #fbf6f7; color: #2a1d22; font-family: "Inter", "Noto Sans", "DejaVu Sans", sans-serif; font-size: 13px; }
QMainWindow, QDialog { background: #fbf6f7; }
QToolTip { background: #ffffff; color: #2a1d22; border: 1px solid #dcbfc9; border-radius: 8px; padding: 6px 8px; }
QLabel { background: transparent; }
QLabel#brand { font-size: 26px; font-weight: 700; color: #2a1d22; padding: 2px 0; letter-spacing: -0.3px; }
QLabel#heading { font-size: 17px; font-weight: 650; color: #2a1d22; }
QLabel#description, QLabel[muted="true"] { color: #6b5560; }
QLabel#status-ok { color: #1c7c4b; font-weight: 600; }
QLabel#status-warn { color: #8a5a00; font-weight: 600; }
QFrame#card { background: #ffffff; border: 1px solid #ecd9df; border-radius: 14px; }
QFrame#card QLabel, QFrame#card QCheckBox, QFrame#card QRadioButton { background: transparent; }
QListWidget, QTableWidget, QTreeWidget, QTextEdit, QPlainTextEdit { background: #ffffff; color: #2a1d22; border: 1px solid #ecd9df; border-radius: 10px; padding: 4px; outline: 0; alternate-background-color: #f6eaee; selection-background-color: #f7cddd; selection-color: #2a1d22; }
QListWidget::item { padding: 9px 11px; border-radius: 8px; min-height: 20px; }
QListWidget::item:hover { background: #f6eaee; }
QListWidget::item:selected, QTableWidget::item:selected, QTreeWidget::item:selected { background: #fadbe7; color: #8e1043; }
QListWidget::item:selected { border-left: 3px solid #c2185b; font-weight: 600; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #ffffff; color: #2a1d22; border: 1px solid #dcbfc9; border-radius: 10px; padding: 6px 10px; min-height: 22px; selection-background-color: #f7cddd; selection-color: #2a1d22; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #c2185b; }
QComboBox QAbstractItemView { background: #ffffff; color: #2a1d22; border: 1px solid #dcbfc9; selection-background-color: #fadbe7; selection-color: #8e1043; }
QPushButton { background: #ffffff; color: #2a1d22; border: 1px solid #dcbfc9; border-radius: 10px; padding: 7px 16px; min-height: 20px; font-weight: 600; text-align: center; }
QPushButton:hover { background: #f6eaee; border-color: #c2185b; }
QPushButton:pressed { background: #fadbe7; }
QPushButton:focus { border: 2px solid #c2185b; }
QPushButton:disabled { color: #a3929a; border-color: #ecd9df; background: #f6eaee; }
QPushButton[variant="primary"] { background: #c2185b; color: #ffffff; border: 1px solid #c2185b; text-align: center; }
QPushButton[variant="primary"]:hover { background: #a3144c; }
QPushButton[variant="danger"] { background: #ffffff; color: #b3261e; border: 1px solid #b3261e; }
QPushButton[variant="danger"]:hover { background: #b3261e; color: #ffffff; }
QPushButton[variant="nav"] { text-align: center; }
QCheckBox, QRadioButton { spacing: 10px; background: transparent; min-height: 26px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; background: #ffffff; border: 2px solid #dcbfc9; }
QRadioButton::indicator { border-radius: 10px; }
QCheckBox::indicator { border-radius: 5px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #c2185b; }
QRadioButton::indicator:checked { background: #ffffff; border: 6px solid #c2185b; width: 8px; height: 8px; }
QCheckBox::indicator:checked { background: #c2185b; border-color: #c2185b; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: #ecd9df; background: #f6eaee; }
QCheckBox:focus, QRadioButton:focus { color: #8e1043; }
QSlider::groove:horizontal { height: 6px; background: #f6eaee; border: 1px solid #ecd9df; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #c2185b; border-radius: 3px; }
QSlider::handle:horizontal { background: #ffffff; border: 2px solid #c2185b; width: 16px; height: 16px; margin: -7px 0; border-radius: 10px; }
QGroupBox { background: #ffffff; border: 1px solid #ecd9df; border-radius: 14px; margin-top: 18px; padding: 12px 10px 10px 10px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; color: #2a1d22; }
QScrollArea { border: 0; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #dcbfc9; border-radius: 4px; min-height: 32px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #dcbfc9; border-radius: 4px; min-width: 32px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QTabWidget::pane { border: 1px solid #ecd9df; border-radius: 10px; background: #ffffff; top: -1px; }
QTabBar::tab { padding: 8px 14px; background: #f6eaee; color: #6b5560; margin: 2px; border-radius: 8px; }
QTabBar::tab:selected { background: #fadbe7; color: #8e1043; }
QHeaderView::section { background: #f6eaee; color: #6b5560; border: 0; border-bottom: 1px solid #ecd9df; padding: 7px; }
QProgressBar { background: #f6eaee; border: 0; border-radius: 5px; height: 10px; text-align: center; color: #2a1d22; }
QProgressBar::chunk { background: #c2185b; border-radius: 5px; }
QStatusBar { color: #6b5560; }
QMessageBox QLabel { color: #2a1d22; }
/* Sakura: soft, round */
QFrame#card { border-radius: 20px; border: 1px solid #ecd9df; }
QPushButton { border-radius: 17px; padding: 7px 18px; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { border-radius: 14px; }
QListWidget::item { border-radius: 12px; }
QListWidget::item:selected { border-left: 0; background: #fadbe7; }
QTabBar::tab { border-radius: 14px; }
