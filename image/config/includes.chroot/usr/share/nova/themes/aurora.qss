/* NOVA Aurora — generated by nova_ui.py (do not edit by hand) */
QWidget { background: #071417; color: #e6fbf6; font-family: "Inter", "Noto Sans", "DejaVu Sans", sans-serif; font-size: 13px; }
QMainWindow, QDialog { background: #071417; }
QToolTip { background: #0d1f24; color: #e6fbf6; border: 1px solid #5c9b9d; border-radius: 10px; padding: 6px 8px; }
QLabel { background: transparent; }
QLabel#brand { font-size: 26px; font-weight: 700; color: #e6fbf6; padding: 2px 0; letter-spacing: -0.3px; }
QLabel#heading { font-size: 17px; font-weight: 650; color: #e6fbf6; }
QLabel#description, QLabel[muted="true"] { color: #9cc7bd; }
QLabel#status-ok { color: #52dca0; font-weight: 600; }
QLabel#status-warn { color: #f4c578; font-weight: 600; }
QFrame#card { background: #0d1f24; border: 1px solid #1f3d45; border-radius: 17px; }
QFrame#card QLabel, QFrame#card QCheckBox, QFrame#card QRadioButton { background: transparent; }
QFrame#card[active="true"] { border: 2px solid #3ee6b0; }
QListWidget, QTableWidget, QTreeWidget, QTextEdit, QPlainTextEdit { background: #0d1f24; color: #e6fbf6; border: 1px solid #1f3d45; border-radius: 14px; padding: 4px; outline: 0; alternate-background-color: #153038; selection-background-color: #193b35; selection-color: #e6fbf6; }
QListWidget::item { padding: 9px 11px; border-radius: 10px; min-height: 20px; }
QListWidget::item:hover { background: #153038; }
QListWidget::item:selected, QTableWidget::item:selected, QTreeWidget::item:selected { background: #193b35; color: #b6ffe3; }
QListWidget::item:selected { border-left: 3px solid #3ee6b0; font-weight: 600; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #0d1f24; color: #e6fbf6; border: 1px solid #5c9b9d; border-radius: 14px; padding: 6px 10px; min-height: 22px; selection-background-color: #193b35; selection-color: #e6fbf6; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #8af5d2; }
QComboBox QAbstractItemView { background: #0d1f24; color: #e6fbf6; border: 1px solid #5c9b9d; selection-background-color: #193b35; selection-color: #b6ffe3; }
QPushButton { background: #0d1f24; color: #e6fbf6; border: 1px solid #5c9b9d; border-radius: 14px; padding: 7px 16px; min-height: 20px; font-weight: 600; text-align: center; }
QPushButton:hover { background: #153038; border-color: #3ee6b0; }
QPushButton:pressed { background: #193b35; }
QPushButton:focus { border: 2px solid #8af5d2; }
QPushButton:disabled { color: #5d8078; border-color: #1f3d45; background: #153038; }
QPushButton[variant="primary"] { background: #3ee6b0; color: #062720; border: 1px solid #3ee6b0; text-align: center; }
QPushButton[variant="primary"]:hover { background: #6af0c4; }
QPushButton[variant="danger"] { background: #0d1f24; color: #fa818a; border: 1px solid #fa818a; }
QPushButton[variant="danger"]:hover { background: #fa818a; color: #1a0508; }
QPushButton[variant="nav"] { text-align: center; }
QCheckBox, QRadioButton { spacing: 10px; background: transparent; min-height: 26px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; background: #0d1f24; border: 2px solid #5c9b9d; }
QRadioButton::indicator { border-radius: 10px; }
QCheckBox::indicator { border-radius: 5px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #3ee6b0; }
QRadioButton::indicator:checked { background: #0d1f24; border: 6px solid #3ee6b0; width: 8px; height: 8px; }
QCheckBox::indicator:checked { background: #3ee6b0; border-color: #3ee6b0; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: #1f3d45; background: #153038; }
QCheckBox:focus, QRadioButton:focus { color: #b6ffe3; }
QSlider::groove:horizontal { height: 6px; background: #153038; border: 1px solid #1f3d45; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #3ee6b0; border-radius: 3px; }
QSlider::handle:horizontal { background: #0d1f24; border: 2px solid #3ee6b0; width: 16px; height: 16px; margin: -7px 0; border-radius: 10px; }
QGroupBox { background: #0d1f24; border: 1px solid #1f3d45; border-radius: 17px; margin-top: 18px; padding: 12px 10px 10px 10px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; color: #e6fbf6; }
QScrollArea { border: 0; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #5c9b9d; border-radius: 4px; min-height: 32px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #5c9b9d; border-radius: 4px; min-width: 32px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QTabWidget::pane { border: 1px solid #1f3d45; border-radius: 14px; background: #0d1f24; top: -1px; }
QTabBar::tab { padding: 8px 14px; background: #153038; color: #9cc7bd; margin: 2px; border-radius: 10px; }
QTabBar::tab:selected { background: #193b35; color: #b6ffe3; }
QHeaderView::section { background: #153038; color: #9cc7bd; border: 0; border-bottom: 1px solid #1f3d45; padding: 7px; }
QProgressBar { background: #153038; border: 0; border-radius: 5px; height: 10px; text-align: center; color: #e6fbf6; }
QProgressBar::chunk { background: #3ee6b0; border-radius: 5px; }
QStatusBar { color: #9cc7bd; }
QMessageBox QLabel { color: #e6fbf6; }
/* Aurora: glowing edges */
QFrame#card { border: 1px solid #1f3d45; border-top: 2px solid #3ee6b0; border-radius: 16px; }
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3ee6b0, stop:0.5 #38bdf8, stop:1 #b18cff); }
QSlider::sub-page:horizontal { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3ee6b0, stop:1 #b18cff); }
