/* NOVA Air light — generated by nova_ui.py (do not edit by hand) */
QWidget { background: #f4f6fa; color: #162033; font-family: "Inter", "Noto Sans", "DejaVu Sans", sans-serif; font-size: 13px; }
QMainWindow, QDialog { background: #f4f6fa; }
QToolTip { background: #ffffff; color: #162033; border: 1px solid #818c9b; border-radius: 8px; padding: 6px 8px; }
QLabel { background: transparent; }
QLabel#brand { font-size: 26px; font-weight: 700; color: #162033; padding: 2px 0; letter-spacing: -0.3px; }
QLabel#heading { font-size: 17px; font-weight: 650; color: #162033; }
QLabel#description, QLabel[muted="true"] { color: #4b5870; }
QLabel#status-ok { color: #1c7c4b; font-weight: 600; }
QLabel#status-warn { color: #8a5a00; font-weight: 600; }
QFrame#card { background: #ffffff; border: 1px solid #dbe2ec; border-radius: 14px; }
QFrame#card QLabel, QFrame#card QCheckBox, QFrame#card QRadioButton { background: transparent; }
QFrame#card[active="true"] { border: 2px solid #1f6feb; }
QListWidget, QTableWidget, QTreeWidget, QTextEdit, QPlainTextEdit { background: #ffffff; color: #162033; border: 1px solid #dbe2ec; border-radius: 10px; padding: 4px; outline: 0; alternate-background-color: #eef2f8; selection-background-color: #dbe9ff; selection-color: #162033; }
QListWidget::item { padding: 9px 11px; border-radius: 8px; min-height: 20px; }
QListWidget::item:hover { background: #eef2f8; }
QListWidget::item:selected, QTableWidget::item:selected, QTreeWidget::item:selected { background: #dbe9ff; color: #163d7e; }
QListWidget::item:selected { border-left: 3px solid #1f6feb; font-weight: 600; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #ffffff; color: #162033; border: 1px solid #818c9b; border-radius: 10px; padding: 6px 10px; min-height: 22px; selection-background-color: #dbe9ff; selection-color: #162033; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #1f6feb; }
QComboBox QAbstractItemView { background: #ffffff; color: #162033; border: 1px solid #818c9b; selection-background-color: #dbe9ff; selection-color: #163d7e; }
QPushButton { background: #ffffff; color: #162033; border: 1px solid #818c9b; border-radius: 10px; padding: 7px 16px; min-height: 20px; font-weight: 600; text-align: center; }
QPushButton:hover { background: #eef2f8; border-color: #1f6feb; }
QPushButton:pressed { background: #dbe9ff; }
QPushButton:focus { border: 2px solid #1f6feb; }
QPushButton:disabled { color: #8b95a6; border-color: #dbe2ec; background: #eef2f8; }
QPushButton[variant="primary"] { background: #1f6feb; color: #ffffff; border: 1px solid #1f6feb; text-align: center; }
QPushButton[variant="primary"]:hover { background: #1a5fd0; }
QPushButton[variant="danger"] { background: #ffffff; color: #c62f3c; border: 1px solid #c62f3c; }
QPushButton[variant="danger"]:hover { background: #c62f3c; color: #ffffff; }
QPushButton[variant="nav"] { text-align: center; }
QCheckBox, QRadioButton { spacing: 10px; background: transparent; min-height: 26px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; background: #ffffff; border: 2px solid #818c9b; }
QRadioButton::indicator { border-radius: 10px; }
QCheckBox::indicator { border-radius: 5px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #1f6feb; }
QRadioButton::indicator:checked { background: #ffffff; border: 6px solid #1f6feb; width: 8px; height: 8px; }
QCheckBox::indicator:checked { background: #1f6feb; border-color: #1f6feb; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: #dbe2ec; background: #eef2f8; }
QCheckBox:focus, QRadioButton:focus { color: #163d7e; }
QSlider::groove:horizontal { height: 6px; background: #eef2f8; border: 1px solid #dbe2ec; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #1f6feb; border-radius: 3px; }
QSlider::handle:horizontal { background: #ffffff; border: 2px solid #1f6feb; width: 16px; height: 16px; margin: -7px 0; border-radius: 10px; }
QGroupBox { background: #ffffff; border: 1px solid #dbe2ec; border-radius: 14px; margin-top: 18px; padding: 12px 10px 10px 10px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; color: #162033; }
QScrollArea { border: 0; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #818c9b; border-radius: 4px; min-height: 32px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #818c9b; border-radius: 4px; min-width: 32px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QTabWidget::pane { border: 1px solid #dbe2ec; border-radius: 10px; background: #ffffff; top: -1px; }
QTabBar::tab { padding: 8px 14px; background: #eef2f8; color: #4b5870; margin: 2px; border-radius: 8px; }
QTabBar::tab:selected { background: #dbe9ff; color: #163d7e; }
QHeaderView::section { background: #eef2f8; color: #4b5870; border: 0; border-bottom: 1px solid #dbe2ec; padding: 7px; }
QProgressBar { background: #eef2f8; border: 0; border-radius: 5px; height: 10px; text-align: center; color: #162033; }
QProgressBar::chunk { background: #1f6feb; border-radius: 5px; }
QStatusBar { color: #4b5870; }
QMessageBox QLabel { color: #162033; }
