/* NEON//SYS — generated by nova_ui.py (do not edit by hand) */
QWidget { background: #0b0714; color: #eafcff; font-family: "Inter", "Noto Sans", "DejaVu Sans", sans-serif; font-size: 13px; }
QMainWindow, QDialog { background: #0b0714; }
QToolTip { background: #140d24; color: #eafcff; border: 1px solid #55418f; border-radius: 8px; padding: 6px 8px; }
QLabel { background: transparent; }
QLabel#brand { font-size: 24px; font-weight: 700; color: #fcee0a; padding: 2px 0; }
QLabel#heading { font-size: 17px; font-weight: 650; color: #eafcff; }
QLabel#description, QLabel[muted="true"] { color: #b3a6d6; }
QLabel#status-ok { color: #3dffa8; font-weight: 600; }
QLabel#status-warn { color: #fcee0a; font-weight: 600; }
QFrame#card { background: #140d24; border: 1px solid #33255a; border-radius: 14px; }
QFrame#card QLabel, QFrame#card QCheckBox, QFrame#card QRadioButton { background: transparent; }
QListWidget, QTableWidget, QTreeWidget, QTextEdit, QPlainTextEdit { background: #140d24; color: #eafcff; border: 1px solid #33255a; border-radius: 10px; padding: 4px; outline: 0; alternate-background-color: #1d1433; selection-background-color: #3b2366; selection-color: #eafcff; }
QListWidget::item { padding: 9px 11px; border-radius: 8px; min-height: 20px; }
QListWidget::item:hover { background: #1d1433; }
QListWidget::item:selected, QTableWidget::item:selected, QTreeWidget::item:selected { background: #0d3540; color: #a6f8ff; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #140d24; color: #eafcff; border: 1px solid #55418f; border-radius: 10px; padding: 6px 10px; min-height: 22px; selection-background-color: #3b2366; selection-color: #eafcff; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #00e5f2; }
QComboBox QAbstractItemView { background: #140d24; color: #eafcff; border: 1px solid #55418f; selection-background-color: #0d3540; selection-color: #a6f8ff; }
QPushButton { background: #140d24; color: #eafcff; border: 1px solid #55418f; border-radius: 10px; padding: 7px 14px; min-height: 20px; font-weight: 600; text-align: left; }
QPushButton:hover { background: #1d1433; border-color: #00e5f2; }
QPushButton:pressed { background: #0d3540; }
QPushButton:focus { border: 2px solid #00e5f2; }
QPushButton:disabled { color: #6f6296; border-color: #33255a; background: #1d1433; }
QPushButton[variant="primary"] { background: #00e5f2; color: #05030b; border: 1px solid #00e5f2; text-align: center; }
QPushButton[variant="primary"]:hover { background: #5cf2fa; }
QPushButton[variant="danger"] { background: #140d24; color: #ff4f8b; border: 1px solid #ff4f8b; }
QPushButton[variant="danger"]:hover { background: #ff4f8b; color: #0b0714; }
QPushButton[variant="nav"] { text-align: center; }
QCheckBox, QRadioButton { spacing: 8px; background: transparent; min-height: 24px; }
QScrollArea { border: 0; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #55418f; border-radius: 4px; min-height: 32px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #55418f; border-radius: 4px; min-width: 32px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QTabWidget::pane { border: 1px solid #33255a; border-radius: 10px; background: #140d24; top: -1px; }
QTabBar::tab { padding: 8px 14px; background: #1d1433; color: #b3a6d6; margin: 2px; border-radius: 8px; }
QTabBar::tab:selected { background: #0d3540; color: #a6f8ff; }
QHeaderView::section { background: #1d1433; color: #b3a6d6; border: 0; border-bottom: 1px solid #33255a; padding: 7px; }
QProgressBar { background: #1d1433; border: 0; border-radius: 5px; height: 10px; text-align: center; color: #eafcff; }
QProgressBar::chunk { background: #00e5f2; border-radius: 5px; }
QStatusBar { color: #b3a6d6; }
QMessageBox QLabel { color: #eafcff; }
/* NEON//SYS extras */
QLabel#brand { font-family: "Orbitron", "Inter", "Noto Sans", sans-serif; font-weight: 900; letter-spacing: 2px; color: #fcee0a; }
QLabel#heading { color: #eafcff; }
QFrame#card { border: 1px solid #33255a; border-top: 2px solid #ff2a6d; border-radius: 4px; }
QPushButton { border-radius: 4px; }
QPushButton:hover { border-color: #00f0ff; color: #00f0ff; }
QPushButton:focus { border: 2px solid #fcee0a; }
QPushButton[variant="primary"] { background: #00e5f2; color: #05030b; border: 1px solid #00f0ff; }
QPushButton[variant="primary"]:hover { background: #5cf2fa; color: #05030b; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #fcee0a; }
QTabBar::tab:selected { background: #140d24; color: #00f0ff; border-bottom: 2px solid #fcee0a; }
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ff2a6d, stop:1 #00f0ff); border-radius: 2px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #55418f; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #ff2a6d; }
QPlainTextEdit, QTextEdit { font-family: "Share Tech Mono", "Noto Sans Mono", monospace; }
