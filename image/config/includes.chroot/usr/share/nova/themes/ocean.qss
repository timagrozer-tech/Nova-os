/* NOVA Ocean — generated by nova_ui.py (do not edit by hand) */
QWidget { background: #06101f; color: #e7f0ff; font-family: "Inter", "Noto Sans", "DejaVu Sans", sans-serif; font-size: 13px; }
QMainWindow, QDialog { background: #06101f; }
QToolTip { background: #0c1a30; color: #e7f0ff; border: 1px solid #2c4a72; border-radius: 8px; padding: 6px 8px; }
QLabel { background: transparent; }
QLabel#brand { font-size: 26px; font-weight: 700; color: #e7f0ff; padding: 2px 0; letter-spacing: -0.3px; }
QLabel#heading { font-size: 17px; font-weight: 650; color: #e7f0ff; }
QLabel#description, QLabel[muted="true"] { color: #9fb4d6; }
QLabel#status-ok { color: #4ade80; font-weight: 600; }
QLabel#status-warn { color: #fbbf24; font-weight: 600; }
QFrame#card { background: #0c1a30; border: 1px solid #1d3352; border-radius: 14px; }
QFrame#card QLabel, QFrame#card QCheckBox, QFrame#card QRadioButton { background: transparent; }
QListWidget, QTableWidget, QTreeWidget, QTextEdit, QPlainTextEdit { background: #0c1a30; color: #e7f0ff; border: 1px solid #1d3352; border-radius: 10px; padding: 4px; outline: 0; alternate-background-color: #12233d; selection-background-color: #1e3a5f; selection-color: #e7f0ff; }
QListWidget::item { padding: 9px 11px; border-radius: 8px; min-height: 20px; }
QListWidget::item:hover { background: #12233d; }
QListWidget::item:selected, QTableWidget::item:selected, QTreeWidget::item:selected { background: #0f2f4d; color: #bfe6ff; }
QListWidget::item:selected { border-left: 3px solid #38bdf8; font-weight: 600; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #0c1a30; color: #e7f0ff; border: 1px solid #2c4a72; border-radius: 10px; padding: 6px 10px; min-height: 22px; selection-background-color: #1e3a5f; selection-color: #e7f0ff; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #38bdf8; }
QComboBox QAbstractItemView { background: #0c1a30; color: #e7f0ff; border: 1px solid #2c4a72; selection-background-color: #0f2f4d; selection-color: #bfe6ff; }
QPushButton { background: #0c1a30; color: #e7f0ff; border: 1px solid #2c4a72; border-radius: 10px; padding: 7px 16px; min-height: 20px; font-weight: 600; text-align: center; }
QPushButton:hover { background: #12233d; border-color: #38bdf8; }
QPushButton:pressed { background: #0f2f4d; }
QPushButton:focus { border: 2px solid #38bdf8; }
QPushButton:disabled { color: #5f7396; border-color: #1d3352; background: #12233d; }
QPushButton[variant="primary"] { background: #38bdf8; color: #03111f; border: 1px solid #38bdf8; text-align: center; }
QPushButton[variant="primary"]:hover { background: #67cdfa; }
QPushButton[variant="danger"] { background: #0c1a30; color: #ff6b77; border: 1px solid #ff6b77; }
QPushButton[variant="danger"]:hover { background: #ff6b77; color: #1a0508; }
QPushButton[variant="nav"] { text-align: center; }
QCheckBox, QRadioButton { spacing: 10px; background: transparent; min-height: 26px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; background: #0c1a30; border: 2px solid #2c4a72; }
QRadioButton::indicator { border-radius: 10px; }
QCheckBox::indicator { border-radius: 5px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #38bdf8; }
QRadioButton::indicator:checked { background: #0c1a30; border: 6px solid #38bdf8; width: 8px; height: 8px; }
QCheckBox::indicator:checked { background: #38bdf8; border-color: #38bdf8; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: #1d3352; background: #12233d; }
QCheckBox:focus, QRadioButton:focus { color: #bfe6ff; }
QSlider::groove:horizontal { height: 6px; background: #12233d; border: 1px solid #1d3352; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #38bdf8; border-radius: 3px; }
QSlider::handle:horizontal { background: #0c1a30; border: 2px solid #38bdf8; width: 16px; height: 16px; margin: -7px 0; border-radius: 10px; }
QGroupBox { background: #0c1a30; border: 1px solid #1d3352; border-radius: 14px; margin-top: 18px; padding: 12px 10px 10px 10px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; color: #e7f0ff; }
QScrollArea { border: 0; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #2c4a72; border-radius: 4px; min-height: 32px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #2c4a72; border-radius: 4px; min-width: 32px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QTabWidget::pane { border: 1px solid #1d3352; border-radius: 10px; background: #0c1a30; top: -1px; }
QTabBar::tab { padding: 8px 14px; background: #12233d; color: #9fb4d6; margin: 2px; border-radius: 8px; }
QTabBar::tab:selected { background: #0f2f4d; color: #bfe6ff; }
QHeaderView::section { background: #12233d; color: #9fb4d6; border: 0; border-bottom: 1px solid #1d3352; padding: 7px; }
QProgressBar { background: #12233d; border: 0; border-radius: 5px; height: 10px; text-align: center; color: #e7f0ff; }
QProgressBar::chunk { background: #38bdf8; border-radius: 5px; }
QStatusBar { color: #9fb4d6; }
QMessageBox QLabel { color: #e7f0ff; }
/* Ocean: crisp */
QFrame#card { border-radius: 8px; }
QPushButton { border-radius: 6px; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { border-radius: 6px; border-bottom: 2px solid #2c4a72; }
QLineEdit:focus, QComboBox:focus { border-bottom: 2px solid #38bdf8; }
QTabBar::tab:selected { border-bottom: 2px solid #38bdf8; }
