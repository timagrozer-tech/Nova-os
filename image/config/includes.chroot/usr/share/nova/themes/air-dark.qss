/* NOVA Air dark — generated by nova_ui.py (do not edit by hand) */
QWidget { background: #11161f; color: #e8eef7; font-family: "Inter", "Noto Sans", "DejaVu Sans", sans-serif; font-size: 13px; }
QMainWindow, QDialog { background: #11161f; }
QToolTip { background: #1a2230; color: #e8eef7; border: 1px solid #43536b; border-radius: 8px; padding: 6px 8px; }
QLabel { background: transparent; }
QLabel#brand { font-size: 24px; font-weight: 700; color: #8bbcff; padding: 2px 0; }
QLabel#heading { font-size: 17px; font-weight: 650; color: #e8eef7; }
QLabel#description, QLabel[muted="true"] { color: #a9b6ca; }
QLabel#status-ok { color: #5fd39a; font-weight: 600; }
QLabel#status-warn { color: #f2c46b; font-weight: 600; }
QFrame#card { background: #1a2230; border: 1px solid #2e3a4d; border-radius: 14px; }
QFrame#card QLabel, QFrame#card QCheckBox, QFrame#card QRadioButton { background: transparent; }
QListWidget, QTableWidget, QTreeWidget, QTextEdit, QPlainTextEdit { background: #1a2230; color: #e8eef7; border: 1px solid #2e3a4d; border-radius: 10px; padding: 4px; outline: 0; alternate-background-color: #212b3b; selection-background-color: #2c4a78; selection-color: #e8eef7; }
QListWidget::item { padding: 9px 11px; border-radius: 8px; min-height: 20px; }
QListWidget::item:hover { background: #212b3b; }
QListWidget::item:selected, QTableWidget::item:selected, QTreeWidget::item:selected { background: #23395b; color: #cfe2ff; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #1a2230; color: #e8eef7; border: 1px solid #43536b; border-radius: 10px; padding: 6px 10px; min-height: 22px; selection-background-color: #2c4a78; selection-color: #e8eef7; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 2px solid #4c93ff; }
QComboBox QAbstractItemView { background: #1a2230; color: #e8eef7; border: 1px solid #43536b; selection-background-color: #23395b; selection-color: #cfe2ff; }
QPushButton { background: #1a2230; color: #e8eef7; border: 1px solid #43536b; border-radius: 10px; padding: 7px 14px; min-height: 20px; font-weight: 600; text-align: left; }
QPushButton:hover { background: #212b3b; border-color: #4c93ff; }
QPushButton:pressed { background: #23395b; }
QPushButton:focus { border: 2px solid #4c93ff; }
QPushButton:disabled { color: #69768a; border-color: #2e3a4d; background: #212b3b; }
QPushButton[variant="primary"] { background: #4c93ff; color: #08111f; border: 1px solid #4c93ff; text-align: center; }
QPushButton[variant="primary"]:hover { background: #6aa6ff; }
QPushButton[variant="danger"] { background: #1a2230; color: #ff6b77; border: 1px solid #ff6b77; }
QPushButton[variant="danger"]:hover { background: #ff6b77; color: #1a0508; }
QPushButton[variant="nav"] { text-align: center; }
QCheckBox, QRadioButton { spacing: 8px; background: transparent; min-height: 24px; }
QScrollArea { border: 0; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #43536b; border-radius: 4px; min-height: 32px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #43536b; border-radius: 4px; min-width: 32px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QTabWidget::pane { border: 1px solid #2e3a4d; border-radius: 10px; background: #1a2230; top: -1px; }
QTabBar::tab { padding: 8px 14px; background: #212b3b; color: #a9b6ca; margin: 2px; border-radius: 8px; }
QTabBar::tab:selected { background: #23395b; color: #cfe2ff; }
QHeaderView::section { background: #212b3b; color: #a9b6ca; border: 0; border-bottom: 1px solid #2e3a4d; padding: 7px; }
QProgressBar { background: #212b3b; border: 0; border-radius: 5px; height: 10px; text-align: center; color: #e8eef7; }
QProgressBar::chunk { background: #4c93ff; border-radius: 5px; }
QStatusBar { color: #a9b6ca; }
QMessageBox QLabel { color: #e8eef7; }
