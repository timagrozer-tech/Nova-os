# NOVA OS: Windows-like shortcuts (generated by tools/gen-plasma-theme.py).
# Users can change everything in System Settings → Shortcuts; `nova-hotkeys reset-kde` restores KDE.

[kwin]
Window Maximize=Meta+Up	Meta+PgUp,Meta+PgUp,Maximize Window
Window Minimize=Meta+Down	Meta+PgDown,Meta+PgDown,Minimize Window
Window Quick Tile Top=none,Meta+Up,Quick Tile Window to the Top
Window Quick Tile Bottom=none,Meta+Down,Quick Tile Window to the Bottom
Overview=Meta+Tab	Meta+W,Meta+W,Toggle Overview

[plasmashell]
next activity=none,Meta+Tab,Walk through activities
previous activity=none,Meta+Shift+Tab,Walk through activities (Reverse)

[KDE Keyboard Layout Switcher]
Switch to Next Keyboard Layout=Meta+Space	Meta+Alt+K,Meta+Alt+K,Switch to Next Keyboard Layout

[org.kde.spectacle.desktop]
RectangularRegionScreenShot=Meta+Shift+S	Meta+Shift+Print,Meta+Shift+Print,Capture Rectangular Region

[services][nova-task-manager.desktop]
_launch=Ctrl+Shift+Esc

[services][nova-control.desktop]
_launch=Meta+I

[services][org.kde.krunner.desktop]
_launch=Alt+Space	Alt+F2	Search	Meta+R	Meta+S

[services][nova-game-bar.desktop]
_launch=Meta+G

[services][org.kde.kinfocenter.desktop]
_launch=Meta+Pause

[services][nova-display.desktop]
_launch=Meta+Shift+P

[services][nova-key-calculator.desktop]
_launch=Calculator

[services][nova-key-explorer.desktop]
_launch=Explorer

[services][nova-key-homepage.desktop]
_launch=Home Page

[services][nova-key-mail.desktop]
_launch=Launch Mail

[services][nova-key-tools.desktop]
_launch=Tools

# NEON//SYS (nova-neon): mode keys do nothing until NEON//SYS is switched on.

[services][nova-neon-center.desktop]
_launch=Meta+Alt+N

[services][nova-neon-work.desktop]
_launch=Ctrl+Meta+Alt+1

[services][nova-neon-game.desktop]
_launch=Ctrl+Meta+Alt+2

[services][nova-neon-night.desktop]
_launch=Ctrl+Meta+Alt+3

[services][nova-neon-focus.desktop]
_launch=Ctrl+Meta+Alt+4

[services][nova-neon-wallpaper.desktop]
_launch=Meta+Alt+W
