# DroidVM OS: добавляется Magisk в init через overlay.d. ${MAGISKTMP} подставляет magiskinit.
on post-fs-data
    exec u:r:magisk:s0 root root -- /system/bin/sh ${MAGISKTMP}/droidvm-pfd.sh ${MAGISKTMP}
    exec_background u:r:magisk:s0 root root -- /system/bin/sh ${MAGISKTMP}/droidvm-watchdog.sh

on property:sys.boot_completed=1
    exec_background u:r:magisk:s0 root root -- /system/bin/sh ${MAGISKTMP}/droidvm-boot.sh ${MAGISKTMP}
